    "optimize:models": "node scripts/optimize-models.mjs",
    "preview": "vite preview",
	"start": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/three": "^0.165.0",
    "sharp": "^0.35.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
