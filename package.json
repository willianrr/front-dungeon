{
  "name": "aranna-web",
  "version": "0.1.0",
  "description": "ARPG web 3D inspirado em Dungeon Siege: Legends of Aranna (esqueleto base)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
